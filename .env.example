# Kronos 模型配置
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=auto
KRONOS_MAX_CONTEXT=512

# 预测参数
# LOOKBACK: 输入历史数据长度（K 线根数），small/base 推荐 400，mini 可用更大值
KRONOS_LOOKBACK=400
# PRED_LEN: 预测未来 K 线根数，推荐 20-120
KRONOS_PRED_LEN=120
# TEMPERATURE: 采样温度，1.0 标准采样，<1.0 更保守，>1.0 更随机
KRONOS_TEMPERATURE=1.0
# TOP_P: 核采样阈值，0.9 保留累积概率前 90% 的 token
KRONOS_TOP_P=0.9
# SAMPLE_COUNT: 并行采样次数，>1 时取均值可得到概率预测
KRONOS_SAMPLE_COUNT=1

# LLM 配置（支持火山引擎 CodingPlan / 智谱 CodingPlan 等）
# 火山引擎: LLM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# 智谱:     LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL_ID=glm-4-flash
LLM_API_KEY=

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# Qlib 数据源配置
# QLIB_PROVIDER_URI: qlib 本地数据目录路径
QLIB_PROVIDER_URI=/data02/home/zxh/qlib_local_data/cn_data

# 批量预测配置
# MAX_BATCH_SIZE: 单次批量预测最大股票数量（受 GPU 显存限制，H20+Kronos-small 推荐 50）
MAX_BATCH_SIZE=50
